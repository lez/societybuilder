#!/bin/bash

BASE=$(dirname $(dirname $(readlink -e $0)))

if [[ $# < 2 || $1 = '-h' || $1 = '--help' ]]; then
    echo "Usage: $0 <command> <production|development|testing> - runs given python script in given environment"
    echo
    echo "Commands: (see $BASE/script)"
    for dir in $(ls $BASE/script | grep -v .pyc$ | grep -v __init__ | sed 's/\.py//g' | grep -v ^__pycache__$  | grep -v ^util$)
    do
        echo " * $dir"
    done
    exit 0
fi

cd $BASE
PYTHONPATH=$BASE python3 script/$1.py $2.ini
