#!/bin/bash

BASE=$(dirname $(dirname $(readlink -e $0)))

if [[ $1 = '-h' || $1 = '--help' ]]; then
    echo "Usage: $0 <command> <production|development|testing> - runs given python script in given environment"
    echo
    echo "Commands: (see $BASE/script)"
    ls $BASE/script | sed 's/\.py//g' | grep -v ^__pycache__$ | grep -v ^util$
    exit 0
fi

PYTHONPATH=/$BASE python $BASE/script/$1.py $2.ini
