[app:main]
use = egg:SocietyBuilder

pyramid.debug_authorization = false
pyramid.debug_notfound = false
pyramid.debug_routematch = false
pyramid.reload_templates = false
pyramid.debug_all = false

pyramid.default_locale_name = en

redis.sessions.url = redis://127.0.0.1:6379/0
redis.sessions.secret = SECKRETMEN
redis.sessions.timeout = 1800
redis.sessions.cookie_name = session
redis.sessions.cookie_max_age = 172800
redis.sessions.cookie_path = /
redis.sessions.cookie_domain =
redis.sessions.cookie_secure = False
redis.sessions.cookie_httponly = False
redis.sessions.cookie_on_exception = True
redis.sessions.serialize = pickle.dumps
redis.sessions.deserialize = pickle.loads

peewee.database = sb
peewee.username = sb
peewee.password = DB_PASSWD
peewee.host = 127.0.0.1
peewee.port = 5432
peewee.debug = false

react.render = false
react.render_url = http://127.0.0.1:9009/render

[server:main]
use = egg:waitress#main
host = 0.0.0.0
port = 80

[loggers]
keys = root, sb

[handlers]
keys = console

[formatters]
keys = generic

[logger_root]
level = INFO
handlers = console

[logger_sb]
level = DEBUG
handlers =
qualname = sb

[handler_console]
class = StreamHandler
args = (sys.stderr,)
level = NOTSET
formatter = generic

[formatter_generic]
format = %(asctime)s %(levelname)-5.5s [%(name)s][%(threadName)s] %(message)s

[uwsgi]
socket = /var/run/uwsgi/uwsgi.sock
master = true
uid = 1000
chdir = /src

processes = 4

harakiri = 60
harakiri-verbose = true
limit-post = 20971520
post-buffering = 65536

daemonize = /var/log/uwsgi.log
pidfile = /var/run/uwsgi/uwsgi.pid

listen = 128

max-requests = 1000

reload-on-as = 128
reload-on-rss = 96
no-orphans = true

log-slow = true
